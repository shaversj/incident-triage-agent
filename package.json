{
  "name": "incident-triage-agent",
  "version": "1.0.0",
  "description": "A bounded LLM-assisted SRE operator for evidence-backed incident triage.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "triage": "tsx src/cli.ts",
    "list": "tsx src/cli.ts list",
    "serve": "tsx src/cli.ts serve",
    "triage:recorded": "tsx scripts/run-recorded-triage.ts",
    "triage:read-only-canary": "tsx scripts/run-recorded-triage.ts --read-only-canary",
    "triage:approval": "tsx src/approval-cli.ts",
    "review:failures": "tsx scripts/failure-review.ts",
    "demo:operator": "tsx scripts/run-operator-demo.ts",
    "approval-demo": "tsx scripts/run-approval-demo.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:postgres": "vitest run tests/postgres-persistence.test.ts",
    "evals": "vitest run --config evals/vitest.evals.config.ts",
    "evals:json": "mkdir -p eval-results && vitest run --config evals/vitest.evals.config.ts --reporter=vitest-evals/reporter --reporter=json --outputFile.json=eval-results/vitest-results.json",
    "evals:ui": "vitest-evals serve eval-results",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-build-assets.mjs",
    "triage:live": "tsx scripts/run-recorded-triage.ts --live"
  },
  "dependencies": {
    "@flue/runtime": "1.0.0-beta.1",
    "pg": "^8.22.0",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.3",
    "valibot": "^1.2.0"
  },
  "devDependencies": {
    "@flue/cli": "^1.0.0-beta.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^25.9.3",
    "@types/pg": "^8.20.3",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9",
    "vitest-evals": "^0.13.1"
  }
}
